{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/session.sh",
              "start",
              "--hook"
            ],
            "timeout": 45,
            "statusMessage": "Reading the project digest"
          }
        ]
      },
      {
        "matcher": "resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/session.sh",
              "ctx",
              "--hook"
            ],
            "timeout": 30,
            "statusMessage": "Refreshing the project digest"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bash scripts/session.sh *)",
      "Bash(bash scripts/check.sh*)",
      "Bash(bash scripts/doctor.sh*)",
      "Bash(bash scripts/cfg.sh *)",
      "Bash(python3 scripts/changelog.py *)",
      "Bash(python3 scripts/todo.py *)",
      "Bash(make doc)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make doctor)",
      "Bash(make ctx)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git submodule status*)",
      "Bash(vim -es *)",
      "Bash(nvim --headless *)",
      "Bash(nvim -l *)",
      "Bash(luajit -bl *)",
      "Bash(bash scripts/feature.sh status*)",
      "Bash(bash scripts/feature.sh list*)",
      "Bash(bash scripts/sync.sh status*)",
      "Bash(python3 scripts/todo.py list*)",
      "Bash(python3 scripts/todo.py all*)",
      "Bash(python3 scripts/todo.py due*)",
      "Bash(python3 scripts/todo.py stale*)",
      "Bash(python3 scripts/todo.py add *)",
      "Bash(python3 scripts/todo.py done *)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make docs)",
      "Bash(make man)",
      "Bash(make todo*)",
      "Bash(git branch --list*)",
      "Bash(git check-ignore *)",
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-*)",
      "Bash(git tag -d*)",
      "Bash(git clean *)",
      "Bash(*PlugClean*)",
      "Edit(priv/**)",
      "Write(priv/**)",
      "Edit(doc/mikevim.txt)",
      "Write(doc/mikevim.txt)",
      "Edit(doc/tags)",
      "Write(doc/tags)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(CLAUDE/CLAUDE.md)",
      "Write(CLAUDE/CLAUDE.md)",
      "Edit(plugged/**)",
      "Write(plugged/**)",
      "Bash(python3 scripts/todo.py rm *)",
      "Edit(man/**)",
      "Write(man/**)"
    ],
    "defaultMode": "acceptEdits",
    "ask": [
      "Bash(git merge*)",
      "Bash(git push*origin master*)",
      "Bash(git push --all*)",
      "Bash(git push --tags*)",
      "Bash(bash scripts/release.sh*)",
      "Bash(make release*)",
      "Bash(gh release*)",
      "Bash(gh repo create*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(rm -r*)",
      "Bash(rm -fr*)",
      "Bash(git submodule add*)",
      "Bash(uv add*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(cargo add*)",
      "Bash(brew install*)",
      "Edit(templates/CLAUDE.md)"
    ]
  }
}
